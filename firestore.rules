rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── BASE DENY-BY-DEFAULT ─────────────────────────────────────────
    // Any document path not explicitly allowed below is unconditionally denied.
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── FAIL-CLOSED AUTHENTICATION & ROLE HELPERS ────────────────────
    
    // Checks if the request is authenticated with a valid UID
    function signedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Verifies that the user's authoritative profile document exists in users/{uid}
    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Retrieves the user's authoritative profile document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Resolves role string safely; fails closed if profile missing or field omitted
    function userRole() {
      return getUserData().get('role', '');
    }

    // Checks that the account is active and role is exactly one of the four known strings
    function isActive() {
      return hasUserDoc() &&
             getUserData().get('active', false) == true &&
             (userRole() in ['superadmin', 'admin', 'staff', 'accountant']);
    }

    // Role-specific helpers (all fail closed if unauthenticated, inactive, or malformed)
    function isSuperAdmin() {
      return isActive() && userRole() == 'superadmin';
    }

    function isAdmin() {
      return isActive() && (userRole() in ['admin', 'superadmin']);
    }

    function isStaff() {
      return isActive() && (userRole() in ['staff', 'admin', 'superadmin']);
    }

    function isAccountant() {
      return isActive() && (userRole() in ['accountant', 'admin', 'superadmin']);
    }

    // ─── USERS COLLECTION ──────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read their own profile; Super Admin can read all
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      
      // All client writes (create, update, delete) are strictly denied.
      // User management (creation, role assignment, status toggling, deletion) is
      // handled exclusively server-side via /api/users using the Firebase Admin SDK.
      allow create, update, delete: if false;
    }

    // ─── AUDIT LOGS (Immutable Security Trail) ─────────────────────
    match /audit_logs/{logId} {
      // Super Admin and Admin can view audit records
      allow read: if isAdmin();
      
      // Any authenticated user can write an audit log for their own actions
      // Must not forge identity: logged userId/actor must equal caller's uid
      allow create: if signedIn() && (
        (request.resource.data.get('userId', '') == request.auth.uid || request.resource.data.get('actor', '') == request.auth.uid) &&
        (request.resource.data.get('userId', request.auth.uid) == request.auth.uid) &&
        (request.resource.data.get('actor', request.auth.uid) == request.auth.uid)
      );
      
      // Audit records are strictly immutable: no updates or deletes permitted
      allow update, delete: if false;
    }

    // ─── TRASH COLLECTION (Soft-Delete & Recovery) ──────────────────
    match /trash/{trashId} {
      // Admin and Superadmin can view, soft-delete, restore, or purge items
      allow read, write, delete: if isAdmin();
    }

    // ─── SYNC FAILURES ─────────────────────────────────────────────
    match /sync_failures/{failureId} {
      // Superadmin-only for reading and clearing diagnostics
      allow read, delete: if isSuperAdmin();
      // Only active authenticated users can record a sync failure for their own UID
      allow create: if isActive() && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if false;
    }

    // ─── BUSINESS SETTINGS ─────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ─── OPERATIONAL ENTITIES (Farmers, Collections, Customers, etc)
    match /farmers/{farmerId} {
      allow read: if signedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if signedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if signedIn();
      allow create: if isStaff() || isAccountant();
      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if signedIn();
      allow create: if isStaff() || isAccountant();
      allow update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if signedIn();
      allow create: if isStaff() || isAccountant();
      allow update, delete: if isAdmin();
    }

    match /daily_spreadsheets/{sheetId} {
      allow read: if signedIn();
      allow create, update: if isStaff() || isAccountant();
      allow delete: if isAdmin();
    }
  }
}
