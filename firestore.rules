rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return hasUserDoc() && getUserData().get('role', '') == 'superadmin';
    }

    function isAdmin() {
      return hasUserDoc() && (getUserData().get('role', '') in ['admin', 'superadmin']);
    }

    function isStaff() {
      return hasUserDoc() && (getUserData().get('role', '') in ['staff', 'accountant', 'admin', 'superadmin']);
    }

    // ─── USERS COLLECTION ──────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read their own profile; Super Admin can read all
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || isAdmin());
      
      // Only Super Admin can create users
      allow create: if isSuperAdmin();
      
      // Super Admin can update any user; users can update their own profile but can never change role, active, or email
      allow update: if isSuperAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'email'])
      );
      
      // Only Super Admin can delete users (client-side protects last superadmin)
      allow delete: if isSuperAdmin();
    }

    // ─── AUDIT LOGS (Immutable Security Trail) ─────────────────────
    match /audit_logs/{logId} {
      // Super Admin and Admin can view audit records
      allow read: if isAdmin();
      
      // Any authenticated mutation writes an audit log (create only)
      // Must not forge identity: logged userId/actor must equal caller's uid
      allow create: if isSignedIn() && (
        (request.resource.data.get('userId', '') == request.auth.uid || request.resource.data.get('actor', '') == request.auth.uid) &&
        (request.resource.data.get('userId', request.auth.uid) == request.auth.uid) &&
        (request.resource.data.get('actor', request.auth.uid) == request.auth.uid)
      );
      
      // Audit records are strictly immutable: no updates or deletes permitted
      allow update, delete: if false;
    }

    // ─── TRASH COLLECTION (Soft-Delete & Recovery) ──────────────────
    match /trash/{trashId} {
      // Only Super Admin and Admin can view, restore, or purge items from trash
      allow read, write, delete: if isAdmin();
    }

    // ─── SYNC FAILURES ─────────────────────────────────────────────
    match /sync_failures/{failureId} {
      allow read, write, delete: if isAdmin();
    }

    // ─── BUSINESS SETTINGS ─────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── OPERATIONAL ENTITIES (Farmers, Collections, Customers, etc)
    match /farmers/{farmerId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /daily_spreadsheets/{sheetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
