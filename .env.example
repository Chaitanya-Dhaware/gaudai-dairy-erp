# ─────────────────────────────────────────────────────────────────────────────
# Gaudai AI Dairy ERP - Environment Variables Template
#
# IMPORTANT SECURITY DIRECTIVE:
# No secret, private key, or backend API token may ever use the `VITE_` prefix!
# Any variable prefixed with `VITE_` is automatically bundled into public client
# JavaScript assets and accessible to any browser visitor.
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. Client-Side Firebase Web Configuration (Safe for Browser) ───────────
VITE_FIREBASE_API_KEY=<FIREBASE_API_KEY>
VITE_FIREBASE_AUTH_DOMAIN=<FIREBASE_AUTH_DOMAIN>
VITE_FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
VITE_FIREBASE_STORAGE_BUCKET=<FIREBASE_STORAGE_BUCKET>
VITE_FIREBASE_MESSAGING_SENDER_ID=<FIREBASE_MESSAGING_SENDER_ID>
VITE_FIREBASE_APP_ID=<FIREBASE_APP_ID>

# Local Emulator Toggle (Only active when DEV=true)
VITE_USE_FIREBASE_EMULATOR=false

# ─── 2. Serverless Backend Secrets (Vercel Server-Side Only) ─────────────────
# NEVER commit real values to version control. Set these in Vercel Project Settings.

# Firebase Admin SDK Service Account
FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
FIREBASE_CLIENT_EMAIL=<FIREBASE_CLIENT_EMAIL>
FIREBASE_PRIVATE_KEY="<FIREBASE_PRIVATE_KEY_RESTORE_LINEBREAKS>"

# Google Apps Script Web App Backend & Shared Secret
# APPS_SCRIPT_SECRET must be at least 32 random characters (fails closed if shorter or missing)
APPS_SCRIPT_URL=<APPS_SCRIPT_URL>
APPS_SCRIPT_SECRET=<APPS_SCRIPT_SECRET_AT_LEAST_32_CHARS>

# Google Gemini AI API Configuration
# GEMINI_MODEL: Must be an approved model (e.g., gemini-2.5-flash-lite, gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash).
# NOTE: Verify active model lifecycle periodically in Google AI Studio; retired models will be rejected.
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.8-flash

# Meta / WhatsApp Business API Access Token
WHATSAPP_TOKEN=<WHATSAPP_TOKEN>

# ─── 3. Distributed Rate Limiting (Optional Shared Store) ────────────────────
# If configured, rate limiting is strictly enforced across all serverless instances via atomic Redis pipeline.
# If omitted or during an upstream Redis outage, falls back to in-memory limiter (best-effort per instance).
UPSTASH_REDIS_REST_URL=<UPSTASH_REDIS_REST_URL>
UPSTASH_REDIS_REST_TOKEN=<UPSTASH_REDIS_REST_TOKEN>
